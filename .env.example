# Backend API URL (Railway-deployed Hono server)
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Salla OAuth (public — used in client-side install URL)
NEXT_PUBLIC_SALLA_CLIENT_ID=

# Supabase (optional — only needed for Realtime, Storage from the browser)
# https://supabase.com/dashboard/project/<project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Sentry / analytics
# NEXT_PUBLIC_SENTRY_DSN=
